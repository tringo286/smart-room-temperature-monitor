            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 34
        }
      },
      "description": "HIGH TEMP while the temperature is at or above the alert threshold."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Device",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
