            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"smartroom\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"device_status\" and r.device == \"${device}\" and r._field == \"value\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
