        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto"
      },
      "description": "Relative humidity. 30–60 % is the usual indoor comfort range."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Feels like",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"smartroom\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"room_climate\" and r.device == \"${device}\")\n  |> filter(fn: (r) => r._field == \"heat_index\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: true)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 18
              },
              {
                "color": "orange",
                "value": 27
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Heat index"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Heat index computed on the NodeMCU from temperature and humidity (NOAA formula).",
      "interval": "10s"
    },
    {
