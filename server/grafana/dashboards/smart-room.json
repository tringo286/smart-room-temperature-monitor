    {
      "id": 12,
      "type": "state-timeline",
      "title": "Alert history",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"smartroom\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"room_climate\" and r.device == \"${device}\")\n  |> filter(fn: (r) => r._field == \"alert\" or r._field == \"buzzer_muted\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: true)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\", \"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alert"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Alert"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Normal",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "HIGH TEMP",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "buzzer_muted"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Buzzer"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
